.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #fffaf3 0%, #fff4e8 100%);
}

.card {
  margin-top: 20rpx;
  background: #fffdf8;
  border-radius: 28rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 10rpx 30rpx rgba(180, 137, 92, 0.1);
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  color: #3e2f25;
}

.desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #7a5b45;
  line-height: 1.6;
}
