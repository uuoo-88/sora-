.home-page {
  position: relative;
  min-height: 100vh;
  padding-bottom: 126rpx;
  overflow-x: hidden;
  background: #fff;
}

.hero {
  position: relative;
  height: 520rpx;
  overflow: hidden;
  background:
    radial-gradient(circle at 82% 6%, rgba(255, 229, 178, 0.92) 0, rgba(255, 229, 178, 0.28) 150rpx, rgba(255, 229, 178, 0) 280rpx),
    linear-gradient(112deg, #fffaf4 0%, #f8eee2 46%, #fff4dd 100%);
}

.hero::before {
  position: absolute;
  top: 112rpx;
  left: 258rpx;
  width: 118rpx;
  height: 78rpx;
  border: 10rpx solid rgba(241, 172, 106, 0.16);
  border-radius: 10rpx;
  background: #fff8ef;
  box-shadow: 0 16rpx 42rpx rgba(101, 66, 34, 0.08);
  content: "";
}

.hero::after {
  position: absolute;
  top: 146rpx;
  right: 44rpx;
  width: 70rpx;
  height: 280rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, rgba(102, 153, 91, 0.32), rgba(102, 153, 91, 0));
  transform: rotate(10deg);
  content: "";
}

.brand {
  position: absolute;
  top: 54rpx;
  left: 58rpx;
  z-index: 3;
  display: flex;
  align-items: center;
}

.deer-logo {
  position: relative;
  display: flex;
  width: 58rpx;
  height: 58rpx;
  margin-right: 14rpx;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: #fff5e7;
}

.deer-face {
  font-size: 44rpx;
  line-height: 58rpx;
}

.antler {
  position: absolute;
  top: -18rpx;
  color: #753f1d;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1;
}

.antler-left {
  left: -6rpx;
  transform: rotate(22deg);
}

.antler-right {
  right: -6rpx;
  transform: rotate(-22deg);
}

.brand-title {
  color: #1d3657;
  font-size: 32rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.brand-en {
  margin-top: 2rpx;
  color: #64748a;
  font-size: 12rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.hero-copy {
  position: absolute;
  top: 154rpx;
  left: 32rpx;
  z-index: 4;
}

.hero-title {
  color: #19375b;
  font-size: 60rpx;
  font-weight: 900;
  line-height: 1.08;
  letter-spacing: 2rpx;
  text-shadow: 0 4rpx 0 rgba(255, 255, 255, 0.7);
}

.second-line {
  margin-top: 16rpx;
  font-size: 46rpx;
  letter-spacing: 1rpx;
}

.second-line text {
  color: #ff6f3f;
  font-size: 52rpx;
}

.hero-subtitle {
  margin-top: 24rpx;
  color: #6d7482;
  font-size: 26rpx;
  letter-spacing: 1rpx;
}

.room-light {
  position: absolute;
  top: -22rpx;
  right: 148rpx;
  width: 132rpx;
  height: 132rpx;
  border-radius: 0 0 90rpx 90rpx;
  background: radial-gradient(circle at 50% 70%, #fff1bd 0, #e4c29f 42%, #9d7452 43%, #9d7452 50%, rgba(157, 116, 82, 0) 52%);
  box-shadow: 0 42rpx 78rpx rgba(255, 214, 121, 0.4);
}

.room-light::before {
  position: absolute;
  top: -46rpx;
  left: 62rpx;
  width: 6rpx;
  height: 76rpx;
  background: #7b583e;
  content: "";
}

.family-scene {
  position: absolute;
  right: -20rpx;
  bottom: 14rpx;
  z-index: 2;
  width: 430rpx;
  height: 380rpx;
}

.adult,
.child,
.desk,
.face,
.body,
.child-body,
.book,
.paper,
.pencil,
.hair,
.child-hair {
  position: absolute;
}

.adult-dad {
  left: 56rpx;
  top: 60rpx;
  width: 160rpx;
  height: 270rpx;
}

.adult-mom {
  left: 186rpx;
  top: 64rpx;
  width: 150rpx;
  height: 260rpx;
}

.child {
  right: 4rpx;
  top: 152rpx;
  width: 132rpx;
  height: 190rpx;
}

.hair {
  top: 0;
  left: 34rpx;
  z-index: 2;
  width: 82rpx;
  height: 58rpx;
  border-radius: 46rpx 46rpx 26rpx 24rpx;
  background: #744328;
  box-shadow: 18rpx -6rpx 0 #5a2e1d, -12rpx 8rpx 0 #8b5230;
}

.bun {
  left: 38rpx;
  background: #7a3e22;
  box-shadow: 54rpx -16rpx 0 -4rpx #6f351e, -10rpx 8rpx 0 #8a4e2e;
}

.child-hair {
  top: 0;
  left: 28rpx;
  z-index: 2;
  width: 76rpx;
  height: 50rpx;
  border-radius: 50rpx 50rpx 24rpx 24rpx;
  background: #6f351e;
  box-shadow: 46rpx -12rpx 0 -12rpx #6f351e;
}

.face {
  top: 38rpx;
  left: 36rpx;
  z-index: 3;
  width: 82rpx;
  height: 92rpx;
  border-radius: 44rpx 44rpx 48rpx 48rpx;
  background: #ffd0a8;
  box-shadow: inset -8rpx -8rpx 0 rgba(185, 93, 54, 0.1);
}

.adult-mom .face {
  left: 34rpx;
  background: #ffd5b1;
}

.child .face {
  top: 36rpx;
  left: 26rpx;
  width: 72rpx;
  height: 78rpx;
  background: #ffd1a5;
}

.eye {
  position: absolute;
  top: 34rpx;
  width: 8rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #3b241c;
}

.left-eye {
  left: 24rpx;
}

.right-eye {
  right: 24rpx;
}

.smile {
  position: absolute;
  left: 31rpx;
  bottom: 20rpx;
  width: 24rpx;
  height: 12rpx;
  border-bottom: 4rpx solid #9a4426;
  border-radius: 0 0 24rpx 24rpx;
}

.child .smile {
  left: 25rpx;
}

.body {
  left: 16rpx;
  bottom: 28rpx;
  width: 128rpx;
  height: 150rpx;
  border-radius: 60rpx 60rpx 28rpx 28rpx;
  background: #cfc7bd;
}

.adult-mom .body {
  background: #f3dfc6;
}

.child-body {
  left: 16rpx;
  bottom: 20rpx;
  width: 96rpx;
  height: 94rpx;
  border-radius: 40rpx 40rpx 18rpx 18rpx;
  background: #ffb338;
  box-shadow: inset 24rpx 0 0 #3c78a4;
}

.book {
  left: -2rpx;
  bottom: 40rpx;
  z-index: 4;
  width: 104rpx;
  height: 76rpx;
  border-radius: 8rpx;
  background: linear-gradient(105deg, #80bad1 0 48%, #f8e7c8 49% 100%);
  transform: rotate(14deg);
  box-shadow: 0 8rpx 12rpx rgba(81, 55, 38, 0.12);
}

.desk {
  left: 2rpx;
  right: 0;
  bottom: 0;
  height: 78rpx;
  border-radius: 48rpx 0 0 0;
  background: rgba(255, 238, 213, 0.82);
}

.paper {
  top: 8rpx;
  left: 162rpx;
  width: 150rpx;
  height: 54rpx;
  border-radius: 8rpx;
  background: #fff;
  transform: rotate(6deg);
  box-shadow: 0 8rpx 18rpx rgba(115, 79, 42, 0.12);
}

.paper::after {
  position: absolute;
  top: 18rpx;
  left: 36rpx;
  width: 58rpx;
  height: 20rpx;
  border-radius: 50%;
  border: 4rpx solid #ffb24b;
  content: "";
}

.pencil {
  width: 72rpx;
  height: 8rpx;
  border-radius: 999rpx;
}

.pencil-one {
  left: 38rpx;
  top: 26rpx;
  background: #ff874c;
  transform: rotate(-8deg);
}

.pencil-two {
  left: 92rpx;
  top: 52rpx;
  background: #498ec7;
  transform: rotate(6deg);
}

.pencil-three {
  right: 18rpx;
  top: 30rpx;
  background: #55a86a;
  transform: rotate(-12deg);
}

.panel {
  position: relative;
  z-index: 5;
  margin-top: -22rpx;
  padding: 34rpx 38rpx 24rpx;
  border-radius: 30rpx 30rpx 0 0;
  background: #fff;
  box-shadow: 0 -10rpx 38rpx rgba(38, 42, 54, 0.08);
}

.search-box {
  display: flex;
  height: 96rpx;
  padding: 10rpx 8rpx 10rpx 24rpx;
  align-items: center;
  border: 2rpx solid #e9edf2;
  border-radius: 34rpx;
  background: #fff;
  box-shadow: 0 10rpx 28rpx rgba(28, 41, 60, 0.09);
}

.magic-icon {
  margin-right: 18rpx;
  color: #9da3ad;
  font-size: 42rpx;
  line-height: 1;
}

.theme-input {
  flex: 1;
  height: 74rpx;
  color: #1f2937;
  font-size: 27rpx;
  line-height: 74rpx;
}

.theme-placeholder {
  color: #a9adb5;
}

.generate-button {
  width: 152rpx;
  height: 76rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 76rpx;
  background: linear-gradient(135deg, #ff8b4a 0%, #ff6f3f 100%);
  box-shadow: 0 10rpx 18rpx rgba(255, 111, 63, 0.28);
}

.generate-button:active {
  transform: scale(0.98);
}

.selector-row {
  display: flex;
  margin-top: 28rpx;
  align-items: center;
  justify-content: space-between;
}

.selector-picker {
  width: 318rpx;
}

.selector-card {
  display: flex;
  height: 94rpx;
  padding: 0 22rpx;
  align-items: center;
  border: 2rpx solid #edf0f4;
  border-radius: 22rpx;
  background: #fff;
  box-shadow: 0 10rpx 26rpx rgba(28, 41, 60, 0.08);
}

.selector-icon {
  position: relative;
  width: 44rpx;
  height: 44rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.graduation-icon::before {
  position: absolute;
  top: 8rpx;
  left: 4rpx;
  width: 32rpx;
  height: 22rpx;
  border: 5rpx solid #19375b;
  border-top: none;
  border-radius: 0 0 6rpx 6rpx;
  content: "";
}

.graduation-icon::after {
  position: absolute;
  top: 0;
  left: 0;
  width: 40rpx;
  height: 24rpx;
  border: 5rpx solid #19375b;
  border-radius: 4rpx;
  transform: rotate(28deg) skew(-18deg);
  content: "";
}

.palette-icon {
  border: 5rpx solid #19375b;
  border-radius: 50%;
}

.palette-icon::before {
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #19375b;
  box-shadow: 14rpx -2rpx 0 #19375b, 22rpx 12rpx 0 #19375b;
  content: "";
}

.palette-icon::after {
  position: absolute;
  right: 5rpx;
  bottom: 4rpx;
  width: 14rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #fff;
  content: "";
}

.selector-copy {
  flex: 1;
}

.selector-title {
  color: #1f2a3a;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1;
}

.selector-value {
  margin-top: 12rpx;
  color: #a4aab4;
  font-size: 22rpx;
  line-height: 1;
}

.selector-value.selected {
  color: #ff6f3f;
}

.chevron {
  color: #9aa1aa;
  font-size: 38rpx;
  line-height: 1;
}

.hot-section {
  margin-top: 42rpx;
}

.hot-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hot-title {
  display: flex;
  align-items: center;
  color: #1e2c43;
  font-size: 30rpx;
  font-weight: 900;
}

.fire-icon {
  margin-right: 8rpx;
  font-size: 30rpx;
}

.more-link {
  color: #8c929b;
  font-size: 22rpx;
}

.more-link text {
  margin-left: 8rpx;
  color: #9ca3af;
  font-size: 34rpx;
  vertical-align: -3rpx;
}

.topic-scroll {
  width: 100%;
  margin-top: 26rpx;
  white-space: nowrap;
}

.topic-track {
  display: inline-flex;
  padding-bottom: 4rpx;
}

.topic-card {
  width: 124rpx;
  margin-right: 16rpx;
  overflow: hidden;
  border-radius: 14rpx;
  background: #fff;
  box-shadow: 0 8rpx 20rpx rgba(28, 41, 60, 0.1);
}

.topic-cover {
  position: relative;
  width: 124rpx;
  height: 112rpx;
  overflow: hidden;
}

.topic-name {
  height: 46rpx;
  color: #172033;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 46rpx;
  text-align: center;
  background: #fff;
}

.cover-labor {
  background: linear-gradient(180deg, #ffcc69 0%, #f7a95d 100%);
}

.cover-earth {
  background: linear-gradient(180deg, #b8f0ff 0%, #d9f8d6 100%);
}

.cover-dragon {
  background: linear-gradient(180deg, #c9f4e8 0%, #ffe7a8 100%);
}

.cover-space {
  background: linear-gradient(180deg, #2f63bd 0%, #5f8fe8 100%);
}

.cover-reading {
  background: linear-gradient(180deg, #a9d8ee 0%, #f1dcc3 100%);
}

.sun {
  position: absolute;
  top: 16rpx;
  right: 20rpx;
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: #ffd74d;
  box-shadow: 0 0 0 8rpx rgba(255, 215, 77, 0.18);
}

.cloud {
  position: absolute;
  height: 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.76);
}

.cloud::before,
.cloud::after {
  position: absolute;
  bottom: 0;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.78);
  content: "";
}

.cloud::before {
  left: 8rpx;
  width: 18rpx;
  height: 18rpx;
}

.cloud::after {
  right: 8rpx;
  width: 14rpx;
  height: 14rpx;
}

.cloud-one {
  top: 20rpx;
  left: 12rpx;
  width: 48rpx;
}

.cloud-two {
  top: 46rpx;
  right: 8rpx;
  width: 36rpx;
}

.cover-figure {
  position: absolute;
  left: 28rpx;
  bottom: 18rpx;
  width: 68rpx;
  height: 52rpx;
}

.figure-kids::before,
.figure-kids::after {
  position: absolute;
  bottom: 0;
  width: 28rpx;
  height: 44rpx;
  border-radius: 16rpx 16rpx 6rpx 6rpx;
  background: #2f6fb8;
  content: "";
}

.figure-kids::before {
  left: 2rpx;
  background: #2f6fb8;
  box-shadow: 6rpx -20rpx 0 -4rpx #ffd0a8;
}

.figure-kids::after {
  right: 2rpx;
  background: #ff6f3f;
  box-shadow: -6rpx -20rpx 0 -4rpx #ffd0a8;
}

.figure-earth {
  width: 62rpx;
  height: 62rpx;
  bottom: 12rpx;
  border-radius: 50%;
  background: #46a7e8;
  box-shadow: inset 12rpx 12rpx 0 #6ac56c, inset -18rpx -8rpx 0 rgba(40, 91, 155, 0.18);
}

.figure-dragon {
  width: 72rpx;
  height: 42rpx;
  bottom: 18rpx;
  border-radius: 50%;
  border: 10rpx solid #31a85c;
  border-top-color: transparent;
  border-left-color: #e85d3c;
  transform: rotate(-12deg);
}

.figure-dragon::after {
  position: absolute;
  top: -20rpx;
  right: -18rpx;
  width: 26rpx;
  height: 26rpx;
  border-radius: 50%;
  background: #e85d3c;
  content: "";
}

.figure-rocket {
  left: 38rpx;
  bottom: 20rpx;
  width: 30rpx;
  height: 58rpx;
  border-radius: 20rpx 20rpx 8rpx 8rpx;
  background: #fff;
  transform: rotate(20deg);
}

.figure-rocket::before {
  position: absolute;
  top: 18rpx;
  left: 8rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #5f8fe8;
  content: "";
}

.figure-rocket::after {
  position: absolute;
  bottom: -22rpx;
  left: 5rpx;
  width: 20rpx;
  height: 28rpx;
  border-radius: 50%;
  background: #ffb13d;
  content: "";
}

.figure-reading {
  left: 34rpx;
  bottom: 14rpx;
  width: 54rpx;
  height: 68rpx;
  border-radius: 30rpx 30rpx 16rpx 16rpx;
  background: #ffcfad;
  box-shadow: 0 -18rpx 0 -2rpx #6f351e;
}

.figure-reading::after {
  position: absolute;
  left: -14rpx;
  bottom: 0;
  width: 82rpx;
  height: 28rpx;
  border-radius: 6rpx;
  background: linear-gradient(90deg, #fffbef 0 48%, #dff0ff 49% 100%);
  content: "";
}

.tabbar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  height: 106rpx;
  padding-top: 14rpx;
  justify-content: space-around;
  border-radius: 0 0 28rpx 28rpx;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -8rpx 28rpx rgba(28, 41, 60, 0.08);
}

.tab-item {
  width: 25%;
  color: #8a8f98;
  font-size: 22rpx;
  line-height: 1.4;
  text-align: center;
}

.tab-item.active {
  color: #ff6f3f;
  font-weight: 700;
}

.tab-icon {
  position: relative;
  width: 36rpx;
  height: 34rpx;
  margin: 0 auto 7rpx;
}

.home-icon::before {
  position: absolute;
  left: 2rpx;
  top: 12rpx;
  width: 32rpx;
  height: 22rpx;
  border-radius: 6rpx 6rpx 4rpx 4rpx;
  background: #ff6f3f;
  content: "";
}

.home-icon::after {
  position: absolute;
  left: 3rpx;
  top: 0;
  width: 30rpx;
  height: 30rpx;
  border-radius: 6rpx;
  background: #ff6f3f;
  transform: rotate(45deg);
  content: "";
}

.folder-icon {
  border: 4rpx solid #969ba4;
  border-radius: 5rpx;
}

.folder-icon::before {
  position: absolute;
  top: -8rpx;
  left: 0;
  width: 16rpx;
  height: 10rpx;
  border: 4rpx solid #969ba4;
  border-bottom: none;
  border-radius: 5rpx 5rpx 0 0;
  content: "";
}

.template-icon {
  border: 4rpx solid #969ba4;
  border-radius: 4rpx;
}

.template-icon::before {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 14rpx;
  width: 4rpx;
  background: #969ba4;
  content: "";
}

.template-icon::after {
  position: absolute;
  top: 12rpx;
  right: 0;
  left: 0;
  height: 4rpx;
  background: #969ba4;
  content: "";
}

.smile-icon {
  border: 4rpx solid #969ba4;
  border-radius: 50%;
}

.smile-icon::before {
  position: absolute;
  top: 9rpx;
  left: 8rpx;
  width: 4rpx;
  height: 4rpx;
  border-radius: 50%;
  background: #969ba4;
  box-shadow: 14rpx 0 0 #969ba4;
  content: "";
}

.smile-icon::after {
  position: absolute;
  left: 10rpx;
  bottom: 7rpx;
  width: 12rpx;
  height: 6rpx;
  border-bottom: 3rpx solid #969ba4;
  border-radius: 0 0 12rpx 12rpx;
  content: "";
}
