.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #fffaf3 0%, #fff4e8 100%);
  padding: 0 24rpx 180rpx;
  box-sizing: border-box;
  color: #4a3c34;
}

.safe-top {
  height: 40rpx;
}

.card {
  background: #fffdf8;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 10rpx 30rpx rgba(180, 137, 92, 0.1);
}

.brand-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.brand-left {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.logo {
  width: 92rpx;
  height: 92rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #ffd9ab 0%, #ffc170 100%);
  color: #6e4320;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.brand-cn {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.3;
}

.brand-en {
  margin-top: 6rpx;
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: #b08b6d;
}

.hero-title {
  font-size: 46rpx;
  line-height: 1.35;
  font-weight: 700;
  color: #3e2f25;
}

.hero-illustration {
  margin-top: 24rpx;
  border-radius: 24rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #fff4e3 0%, #ffe9cf 100%);
}

.scene-row {
  display: flex;
  gap: 20rpx;
}

.scene-person {
  flex: 1;
  border-radius: 20rpx;
  padding: 20rpx 16rpx;
  background: #fff9ef;
  text-align: center;
}

.scene-emoji {
  display: block;
  font-size: 42rpx;
}

.scene-label {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #7a5b45;
}

.scene-home {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #906a4d;
  text-align: center;
}

.topic-input {
  width: 100%;
  height: 86rpx;
  border-radius: 22rpx;
  background: #fff4e5;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  color: #513a29;
}

.pickers-row {
  margin-top: 18rpx;
  display: flex;
  gap: 14rpx;
}

.picker-trigger {
  flex: 1;
  border-radius: 20rpx;
  background: #fff6ea;
  padding: 18rpx;
}

.picker-label {
  font-size: 22rpx;
  color: #a07c5f;
}

.picker-value {
  margin-top: 8rpx;
  display: block;
  font-size: 28rpx;
  color: #9f907f;
  font-weight: 500;
}

.picker-value.active {
  color: #5a4332;
}

.generate-btn {
  margin-top: 24rpx;
  height: 88rpx;
  border-radius: 24rpx;
  border: none;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #ffae4b 0%, #ff7b2e 100%);
  box-shadow: 0 12rpx 28rpx rgba(255, 127, 50, 0.35);
}

.generate-btn::after {
  border: none;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
}

.hot-scroll {
  margin-top: 16rpx;
  white-space: nowrap;
}

.hot-list {
  display: inline-flex;
  gap: 14rpx;
  padding-bottom: 6rpx;
}

.hot-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #fff3df;
  color: #734f36;
  font-size: 25rpx;
}

.tabbar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 20rpx;
  height: 108rpx;
  background: rgba(255, 253, 248, 0.96);
  border-radius: 28rpx;
  box-shadow: 0 10rpx 30rpx rgba(170, 130, 87, 0.18);
  display: flex;
  align-items: center;
  justify-content: space-around;
  backdrop-filter: blur(8rpx);
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #9c846f;
}

.tab-icon {
  font-size: 30rpx;
  line-height: 1;
}

.tab-text {
  margin-top: 8rpx;
  font-size: 22rpx;
}

.tab-active {
  color: #ef7f2a;
  font-weight: 700;
}

.mask {
  position: fixed;
  inset: 0;
  background: rgba(46, 34, 27, 0.45);
  display: flex;
  align-items: flex-end;
  z-index: 99;
}

.popup {
  width: 100%;
  background: #fffdf9;
  border-radius: 30rpx 30rpx 0 0;
  padding: 28rpx 24rpx calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.popup-title {
  font-size: 30rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 16rpx;
  color: #4a3729;
}

.popup-option {
  height: 84rpx;
  border-radius: 18rpx;
  background: #fff5e8;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #614837;
}

.popup-cancel {
  margin-top: 8rpx;
  height: 84rpx;
  border-radius: 18rpx;
  background: #f5ece1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #896f5b;
}
